# Optionnel — voir la note dans app/api/contact/route.ts
#
# Si ces variables sont définies, le formulaire de contact envoie l'email via
# l'API Resend (https://resend.com, gratuit jusqu'à 3000 emails/mois).
# Si elles sont absentes, le formulaire bascule automatiquement sur un lien
# mailto: prérempli (aucune configuration nécessaire, mais moins fluide).

RESEND_API_KEY=
CONTACT_TO_EMAIL=bacem.kallel@tunicare.tn
